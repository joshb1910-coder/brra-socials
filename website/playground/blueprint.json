{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Bury & Rochdale RA test site",
    "description": "WordPress test copy of buryrefs.org.uk: BRRA theme, events with RSVP, committee and membership with the automatic first-time discount.",
    "author": "Bury & Rochdale RA"
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
