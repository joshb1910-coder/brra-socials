{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "navy", "name": "Navy", "color": "#050F1C" },
				{ "slug": "navy-soft", "name": "Navy (soft)", "color": "#0D1B2C" },
				{ "slug": "footer", "name": "Footer navy", "color": "#020A14" },
				{ "slug": "gold", "name": "Gold", "color": "#D4AF37" },
				{ "slug": "gold-text", "name": "Gold (text on white)", "color": "#8A6D12" },
				{ "slug": "ink", "name": "Ink", "color": "#0B1626" },
				{ "slug": "slate", "name": "Slate", "color": "#3E4C60" },
				{ "slug": "mist", "name": "Mist", "color": "#F3F5F8" },
				{ "slug": "line", "name": "Line", "color": "#E1E6ED" },
				{ "slug": "cloud", "name": "Cloud (text on navy)", "color": "#DCE3EC" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "8px" },
				{ "slug": "20", "name": "S", "size": "16px" },
				{ "slug": "30", "name": "M", "size": "24px" },
				{ "slug": "40", "name": "L", "size": "clamp(28px, 4vw, 40px)" },
				{ "slug": "50", "name": "XL", "size": "clamp(40px, 6vw, 64px)" },
				{ "slug": "60", "name": "XXL", "size": "clamp(56px, 8vw, 96px)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "14px" },
				{ "slug": "medium", "name": "Medium", "size": "17px" },
				{ "slug": "large", "name": "Large", "size": "19px", "fluid": { "min": "17px", "max": "19px" } },
				{ "slug": "x-large", "name": "Extra large", "size": "28px", "fluid": { "min": "22px", "max": "28px" } },
				{ "slug": "xx-large", "name": "Huge", "size": "38px", "fluid": { "min": "28px", "max": "38px" } },
				{ "slug": "display", "name": "Display", "size": "62px", "fluid": { "min": "36px", "max": "62px" } }
			],
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Montserrat",
					"fontFamily": "Montserrat, 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Montserrat", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat-latin-600-normal.woff2" ] },
						{ "fontFamily": "Montserrat", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat-latin-700-normal.woff2" ] },
						{ "fontFamily": "Montserrat", "fontWeight": "800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat-latin-800-normal.woff2" ] },
						{ "fontFamily": "Montserrat", "fontWeight": "900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat-latin-900-normal.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Open Sans",
					"fontFamily": "'Open Sans', 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Open Sans", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/open-sans-latin-400-normal.woff2" ] },
						{ "fontFamily": "Open Sans", "fontWeight": "400", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/open-sans-latin-400-italic.woff2" ] },
						{ "fontFamily": "Open Sans", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/open-sans-latin-600-normal.woff2" ] },
						{ "fontFamily": "Open Sans", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/open-sans-latin-700-normal.woff2" ] }
					]
				}
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|white", "text": "var:preset|color|ink" },
		"spacing": {
			"blockGap": "24px",
			"padding": { "left": "24px", "right": "24px", "top": "0", "bottom": "0" }
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "900", "lineHeight": "1.12", "letterSpacing": "-0.005em" },
				"color": { "text": "inherit" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|display", "lineHeight": "1.05" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "20px", "fontWeight": "800", "lineHeight": "1.3" } },
			"h4": { "typography": { "fontSize": "17px", "fontWeight": "800" } },
			"link": {
				"color": { "text": "var:preset|color|ink" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|gold-text" } }
			},
			"button": {
				"color": { "background": "var:preset|color|gold", "text": "var:preset|color|navy" },
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "800", "fontSize": "16px", "lineHeight": "1.2" },
				"border": { "radius": "4px" },
				"spacing": { "padding": { "top": "16px", "bottom": "16px", "left": "28px", "right": "28px" } },
				":hover": { "color": { "background": "#E3C35A", "text": "var:preset|color|navy" } },
				":focus": { "outline": { "color": "var:preset|color|gold", "offset": "3px", "style": "solid", "width": "2px" } }
			},
			"caption": { "typography": { "fontSize": "14px" }, "color": { "text": "var:preset|color|slate" } }
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "700", "fontSize": "15px" }
			},
			"core/post-title": {
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "900" }
			},
			"core/post-date": { "typography": { "fontSize": "14px", "fontWeight": "700" }, "color": { "text": "var:preset|color|gold-text" } },
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|gold", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "24px" } }
			},
			"core/separator": { "color": { "text": "var:preset|color|line" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-full", "title": "Full width (no title)", "postTypes": [ "page" ] }
	]
}
